#!/usr/bin/env bash
# Run the full static-analysis + security suite: RuboCop, Brakeman, bundle-audit.
# Exits non-zero on the first failure.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "== RuboCop =="
bundle exec rubocop

echo
echo "== Brakeman =="
bundle exec brakeman --no-pager

echo
echo "== bundle-audit =="
bundle exec bundle-audit check --update

echo
echo "All checks passed."
