# Database
DATABASE_URL=postgres://penca:penca@localhost:5432/penca_development

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=replace_me_with_rails_secret
RAILS_MASTER_KEY=replace_me

# Admin allowlist (comma-separated emails that auto-promote to admin)
ADMIN_EMAILS=86.santiago@gmail.com

# Google OAuth (from Google Cloud Console — see "Google OAuth setup" in README.md)
# Leave blank to run without Google sign-in; the app still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# football-data.org
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Resend (transactional email)
RESEND_API_KEY=
MAIL_FROM=Penca Mundial <no-reply@yourdomain.com>

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Frontend base URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Run solid_queue inside Puma instead of a separate worker (free tier friendly)
SOLID_QUEUE_IN_PUMA=true
